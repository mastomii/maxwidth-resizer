{
  "manifest_version": 3,
  "name": "MaxWidth Resizer",
  "version": "1.0.0",
  "description": "Caps the content width on sites that stretch edge to edge, so text stays readable on a wide screen. Off until you enable it.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MaxWidth Resizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared.js",
        "src/storage.js",
        "src/selector.js",
        "src/detector.js",
        "src/apply.js",
        "src/toast.js",
        "src/picker.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Toggle max-width on this site"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pick the element to limit"
    }
  }
}
